#!/bin/sh
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
modprobe sd_mod
modprobe ext4
modprobe virtio_pci
modprobe virtio_net
mkdir -p /newroot
for i in $(seq 1 100); do
  [ -b /dev/sda ] && break
  sleep .1
done
if ! mount -t ext4 -o rw,noatime /dev/sda /newroot; then
  echo 'Persistent root could not be mounted. Recovery shell; disk is preserved.' >/dev/ttyS0
  exec /bin/sh </dev/ttyS0 >/dev/ttyS0 2>&1
fi
resize2fs /dev/sda >/dev/null 2>&1 || { echo "Disk expansion failed; recovery shell." >/dev/ttyS0; exec /bin/sh </dev/ttyS0 >/dev/ttyS0 2>&1; }
# App-owned, ephemeral transport tools. Keep existing user-managed ssh commands.
mkdir -p /newroot/opt/pocket-ssh /newroot/usr/local/bin
mount -t tmpfs -o size=4m tmpfs /newroot/opt/pocket-ssh
cp -a /pocket-ssh/. /newroot/opt/pocket-ssh/
if [ ! -e /newroot/usr/local/bin/ssh ] && [ ! -L /newroot/usr/local/bin/ssh ]; then
  ln -s /opt/pocket-ssh/ssh /newroot/usr/local/bin/ssh
fi
mkdir -p /newroot/opt/pocket-go-tmp
mount -t tmpfs -o size=128m,mode=1777 tmpfs /newroot/opt/pocket-go-tmp
cat >/newroot/etc/profile.d/pocket-packages.sh <<'PROFILE'
export GOTMPDIR=/opt/pocket-go-tmp
export GOMAXPROCS=1
export GOFLAGS="${GOFLAGS:--p=1}"
PROFILE
ip link set eth0 up
ip addr add 192.168.86.100/24 dev eth0
ip route add default via 192.168.86.1
printf 'nameserver 192.168.86.1\n' >/newroot/etc/resolv.conf
if [ ! -e /newroot/etc/apk/repositories.before-pocket ]; then
  cp /newroot/etc/apk/repositories /newroot/etc/apk/repositories.before-pocket
fi
printf 'http://packages.pocket.invalid/main\nhttp://packages.pocket.invalid/community\n' >/newroot/etc/apk/repositories
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
exec switch_root /newroot /sbin/pocket-init
